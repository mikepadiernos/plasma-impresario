#
# Lets the installed Plasma Impresario create the unprivileged user namespaces
# that the QtWebEngine renderer sandbox needs on systems that restrict them,
# such as Ubuntu 24.04 and later. Like the distribution's own browser profiles,
# it confines nothing else. install.sh replaces @BINARY@ with the installed path.

abi <abi/4.0>,
include <tunables/global>

profile plasma-impresario "@BINARY@" flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/plasma-impresario>
}
