# Headless Linux build and test environment for Plasma Impresario.
#
# This environment builds the app and runs its QtTest suite with the offscreen
# platform. Dovecot serves the synthetic live IMAP tests, clamd the live scan
# test, and Xvfb, x11vnc and Openbox provide the VNC session of vnc.sh and the
# display of the scripted end-to-end scenarios, e2e-scenarios.sh. The
# Fedora release is pinned; synthetic-dovecot.sh requires the Dovecot 2.4
# series and prints the exact version on each run. The image does not provide a
# Plasma session, so D-Bus services, KWallet, notifications, and visual behavior
# still need verification on Plasma.
#
# Build and use it through tools/dev-container/run.sh. Wrap app runs in
# dbus-run-session when they need a session bus.

FROM fedora:44

# Networks that intercept TLS can provide an extra root certificate through the
# optional "extra_ca" build secret.
RUN --mount=type=secret,id=extra_ca,required=false \
    if [ -s /run/secrets/extra_ca ]; then \
        cp /run/secrets/extra_ca /etc/pki/ca-trust/source/anchors/extra-ca.pem && \
        update-ca-trust; \
    fi

RUN dnf -y install --setopt=install_weak_deps=False \
        ccache \
        clang-tools-extra \
        cmake \
        gcc-c++ \
        git-core \
        ninja-build \
        extra-cmake-modules \
        qt6-qtbase-devel \
        qt6-qt5compat-devel \
        qt6-qtsvg-devel \
        qt6-qttools-devel \
        qt6-qtwebengine-devel \
        qt6-linguist \
        kf6-kitemmodels-devel \
        kf6-kdoctools-devel \
        kf6-sonnet-devel \
        kf6-knotifications-devel \
        kf6-kfilemetadata-devel \
        kf6-kio-devel \
        akonadi-contacts-devel \
        qtkeychain-qt6-devel \
        gpgmepp-devel \
        qgpgme-qt6-devel \
        mimetic-devel \
        ragel \
        zlib-ng-compat-devel \
        dbus-daemon \
        gnupg2 \
        python3 \
        gtk-update-icon-cache \
        breeze-icon-theme \
        dovecot \
        openssl \
        xorg-x11-server-Xvfb \
        x11vnc \
        openbox \
        xcb-util-cursor \
        libxkbcommon-x11 \
        mesa-dri-drivers \
    && dnf clean all

# KDE PIM calendars for the My Day panel, which builds without them.
RUN dnf -y install --setopt=install_weak_deps=False \
        akonadi-calendar-devel \
        kf6-kcalendarcore-devel \
    && dnf clean all

# ClamAV's daemon for the opt-in live scan test, live-clamd.sh, which loads only
# its own test signature.
RUN dnf -y install --setopt=install_weak_deps=False \
        clamd \
    && dnf clean all

# gcovr summarizes the coverage build of the release gate, release-gate.sh.
RUN dnf -y install --setopt=install_weak_deps=False \
        gcovr \
    && dnf clean all

# The AT-SPI registry, its Python bindings and Pillow drive and photograph the
# app in the scripted end-to-end scenarios, e2e-scenarios.sh.
RUN dnf -y install --setopt=install_weak_deps=False \
        at-spi2-core \
        python3-pyatspi \
        python3-dbus \
        python3-gobject \
        python3-pillow \
        xdotool \
    && dnf clean all

# KDE Online Accounts, for Nextcloud accounts connected in System Settings,
# which the app builds without.
RUN dnf -y install --setopt=install_weak_deps=False \
        kaccounts-integration-qt6-devel \
        libaccounts-qt6-devel \
        signon-qt6-devel \
    && dnf clean all

ENV CCACHE_DIR=/ccache \
    CMAKE_C_COMPILER_LAUNCHER=ccache \
    CMAKE_CXX_COMPILER_LAUNCHER=ccache \
    QT_QPA_PLATFORM=offscreen

WORKDIR /src
