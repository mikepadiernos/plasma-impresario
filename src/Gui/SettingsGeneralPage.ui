      <item>
       <widget class="QCheckBox" name="mboxDropActionCheckbox">
        <property name="enabled">
         <bool>true</bool>
        </property>
        <property name="toolTip">
         <string>&lt;p&gt;If enabled, you can set the default drag and drop action for the mailbox tree.&lt;/p&gt;&lt;p&gt;If disabled, Plasma Impresario will ask you every time. You can always override the action using modifier keys when dropping (control: copy, shift: move).&lt;/p&gt;</string>
        </property>
        <property name="text">
