[Desktop Entry]
Type=Application
Name=Plasma Impresario
GenericName=IMAP E-mail Client
TryExec=plasma-impresario
Exec=plasma-impresario %u
Icon=io.github.mikepadiernos.plasma_impresario
NoDisplay=true
Terminal=false
MimeType=x-scheme-handler/mailto;
Actions=Composer;

[Desktop Action Composer]
Name=New Message
Exec=plasma-impresario -c
