set(binary "${CMAKE_INSTALL_PREFIX}/bin/plasma-impresario@CMAKE_EXECUTABLE_SUFFIX@")
set(try_exec "${binary}")
string(REPLACE "\\" "\\\\" try_exec "${try_exec}")
string(REPLACE " " "\\s" try_exec "${try_exec}")

set(exec "${binary}")
string(REPLACE "%" "%%" exec "${exec}")
string(REPLACE "\\" "\\\\" exec "${exec}")
string(REPLACE "\"" "\\\"" exec "${exec}")
string(REPLACE "$" "\\$" exec "${exec}")
string(REPLACE "`" "\\`" exec "${exec}")
string(REPLACE "\\" "\\\\" exec "${exec}")
set(exec "\"${exec}\"")

set(data_dir "@CMAKE_INSTALL_DATAROOTDIR@")
if(NOT IS_ABSOLUTE "${data_dir}")
    set(data_dir "${CMAKE_INSTALL_PREFIX}/${data_dir}")
endif()
foreach(desktop_id io.github.mikepadiernos.plasma_impresario org.kde.trojita)
    set(desktop_file "$ENV{DESTDIR}${data_dir}/applications/${desktop_id}.desktop")
    file(READ "${desktop_file}" contents)
    string(REPLACE "TryExec=plasma-impresario" "TryExec=${try_exec}" contents "${contents}")
    string(REPLACE "Exec=plasma-impresario" "Exec=${exec}" contents "${contents}")
    file(WRITE "${desktop_file}" "${contents}")
endforeach()
